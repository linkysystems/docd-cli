{
  "name": "@linkysystems/docd",
  "version": "1.0.0",
  "description": "CLI to install and update the Docs-First Development (DFD) pattern in any project.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "docd": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && rm -rf dist/templates && cp -r src/templates dist/templates",
    "dev": "tsx src/index.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "diff": "^5.2.0",
    "mri": "^1.2.0",
    "picocolors": "^1.0.1",
    "prompts": "^2.4.2",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^20.14.10",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18"
  }
}
